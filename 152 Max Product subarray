class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int currMax = nums[0];
        int currMin = nums[0];
        int maxProduct = nums[0];

        for (int i = 1; i < nums.size(); i++){
            int val = nums[i];
            int temp =currMax;

            currMax = max(val, max(val*currMax,val*currMin));
            currMin = min(val, min(val*temp , val * currMin)); 

            maxProduct = max(currMax,maxProduct);
        }
        return maxProduct;

        
    }
};
