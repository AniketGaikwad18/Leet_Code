class Solution {
public:
    int maxSubarraySumCircular(vector<int>& nums) {
        int currMax = 0 ;
        int currMin = 0;

        int maxSum = INT_MIN;
        int minSum = INT_MAX;

        int totalSum = 0;

        for(int val: nums){
            
            currMax = max(val, currMax + val);
            maxSum = max(maxSum,currMax);

            currMin = min(val,currMin + val);
            minSum = min(minSum , currMin);

            totalSum += val;
        }
        if(maxSum < 0){
            return maxSum;
        }

        return max(maxSum, totalSum - minSum);
    }   
};
